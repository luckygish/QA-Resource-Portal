{
  "name": "qa-resource-portal",
  "version": "1.0.0",
  "description": "QA resource management portal (MVP, JSON-file storage)",
  "main": "server.js",
  "bin": {
    "qa-portal": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --output portal.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.1",
    "date-fns": "^2.30.0",
    "frappe-gantt": "^0.6.1"
  }
}