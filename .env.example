# Скопируйте этот файл в .env и заполните значениями.
# ЗНАЧЕНИЯ СЕКРЕТОВ НЕ КОММИТИТЬ.

# --- Порт открываемых сервисов (хостовые) ---
PORTAL_PORT=3001
MYSKILLS_PORT=3200

# --- PostgreSQL (убедитесь, что совпадает с db-контейнером и настроен) ---
DB_NAME=qa_portal
DB_USER=portal
DB_PASSWORD=portal_pwd

# --- Jira-интеграция портала ---
# URL корпоративного Jira (без trailing slash)
JIRA_URL=https://jira.gnivc.ru

# Единый серверный токен (PAT). Если он же используется как личный — можно оставить пустым.
JIRA_PERSONAL_TOKEN=

# OAuth 2.0 / 3LO (Jira Data Center) — только если настроено приложение.
# Работает и без него: корпоративные УЗ входят по личному токену в поле входа.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/jira/callback

# Первый/основной администратор (email из Jira). При входе с этим email без админов в БД — роль admin.
ADMIN_JIRA_EMAIL=ButovDS@gnivc.ru

# Внутренний токен: MySkills -> портал для сохранения оценок и чтения Лидов.
# Задайте произвольную длинную строку (один и тот же файл .env используется обоими сервисами).
PORTAL_IMPORT_TOKEN=